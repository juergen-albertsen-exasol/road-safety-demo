# The road safety service as a container: runs as the sidecar `road-safety-service` of the
# Exasol Personal deployment. Built in the deployment's own container engine by
# scripts/service_sidecar.py (`./demo sidecar install`); nothing is pushed to a registry.
#
# Python 3.12 (Python Software Foundation License) on Debian; pyexasol (MIT), kafka-python
# (Apache 2.0). The code and SQL are this repo's.
FROM docker.io/library/python:3.12.12-slim

RUN pip install --no-cache-dir --disable-pip-version-check --root-user-action=ignore pyexasol==1.3.0 kafka-python==3.0.13 \
    && useradd --uid 10001 --no-create-home --home-dir /app service

WORKDIR /app
COPY scripts/ scripts/
COPY roadsafety/ roadsafety/

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    KAFKA_BOOTSTRAP=kafka:9092 \
    TZ=Europe/Berlin
USER service
ENTRYPOINT ["python", "scripts/road_safety_service.py"]
